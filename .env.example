# Copy to .env.local. Nothing here is required for the site to run today —
# these are the contract for the phases described in README.md.

# Public origin, used for canonical URLs, OpenGraph and JSON-LD. Set it to the
# real domain in production; a wrong value only affects those tags, never the
# admin. (It is deliberately NOT handed to Payload as `serverURL` — pinning
# Payload to one origin makes every admin save 403 on any other host, silently.)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Payload CMS (content only: portfolio, testimonials, FAQs, page copy) ---
# This site's own small Postgres. It holds content, never bookings.
DATABASE_URI=
PAYLOAD_SECRET=

# --- Bookings API (commerce lives here, not in this app) -------------------
# Server-side only. Never expose as NEXT_PUBLIC_*: this key can create bookings.
SENTRY_API_BASE=
SENTRY_BOOKINGS_KEY=

# --- Transactional email (studio-branded, sent from this app) --------------
RESEND_API_KEY=

# --- Media storage for CMS uploads (R2 / Vercel Blob) ----------------------
BLOB_READ_WRITE_TOKEN=

# --- Protects the confirm-poller cron route --------------------------------
CRON_SECRET=
